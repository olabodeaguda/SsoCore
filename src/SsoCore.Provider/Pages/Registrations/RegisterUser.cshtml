@page
@model SsoCore.Provider.Pages.Registrations.RegisterUserModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Sign Up";
}

<div class="bg-white rounded-lg shadow-lg w-full max-w-lg py-8 px-10 sm:py-4">
    <h2 class="text-2xl font-semibold text-center text-gray-800">Create an account</h2>

    <form method="post" class="space-y-4 py-4">
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="mb-2 px-3 py-2.5 bg-red-50 text-red-700 rounded-md text-sm">
                @Model.Error
            </div>
        }
        
            <div class="flex space-x-4">
                <div class="w-1/2">
                    <label for="FirstName" class="block text-gray-500 text-sm mb-2">First name <span class="text-red-500">*</span></label>
                    <input id="FirstName" name="FirstName" type="text"
                           class="w-full px-4 py-2.5 rounded-md bg-gray-50 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#1a5b96] focus:border-transparent"
                           placeholder="eg. John"
                           value="@Model.FirstName"
                           required />
                    <span asp-validation-for="FirstName" class="text-red-500 text-sm"></span>
                </div>

                <div class="w-1/2">
                    <label for="LastName" class="block text-gray-500 text-sm mb-2">Last name <span class="text-red-500">*</span></label>
                    <input id="LastName" name="LastName" type="text"
                           class="w-full px-4 py-2.5 rounded-md bg-gray-50 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#1a5b96] focus:border-transparent"
                           placeholder="eg. Alicia"
                           value="@Model.LastName"
                           required />
                    <span asp-validation-for="LastName" class="text-red-500 text-sm"></span>
                </div>
            </div>

            <div>
                <label for="Email" class="block text-gray-500 text-sm mb-2">Email <span class="text-red-500">*</span></label>
                <input id="Email" name="Email" type="email"
                       class="w-full px-4 py-2.5 rounded-md bg-gray-50 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#1a5b96] focus:border-transparent"
                       placeholder="eg. myemailid@domain.com"
                       value="@Model.Email"
                       required />
                <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label for="PhoneNumber" class="block text-gray-500 text-sm mb-2">Phone number</label>
                <div class="flex space-x-2">
                    <div class="relative">
                        <button type="button" id="countryCodeBtn" class="flex items-center h-[46px] px-3 bg-gray-50 border border-r-0 border-gray-200 rounded-l-md focus:outline-none focus:ring-2 focus:ring-[#1a5b96] focus:border-transparent">
                            <img src="~/assets/flags/ng.svg" alt="Nigeria" class="w-4 h-4 mr-2" />
                            <span class="text-sm mr-2">+234</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        <input type="hidden" id="CountryCode" name="CountryCode" value="+234" />
                    </div>
                    <input id="PhoneNumber" name="PhoneNumber" type="tel"
                           class="flex-1 px-4 py-2.5 rounded-r-md bg-gray-50 border border-l-0 border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#1a5b96] focus:border-transparent"
                           placeholder="Enter phone number"
                           value="@Model.PhoneNumber" />
                </div>
                <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label for="Password" class="block text-gray-500 text-sm mb-2">Password<span class="text-red-500">*</span></label>
                <div class="relative">
                    <input id="Password" name="Password" type="password"
                           class="w-full px-4 py-2.5 rounded-md bg-gray-50 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#1a5b96] focus:border-transparent"
                           placeholder="Enter password"
                           required
                           oninput="checkPasswordStrength()" />
                    <button type="button" id="togglePassword" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>
            </div>

            <div id="passwordStrengthContainer" class="space-y-4 hidden">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">Password Strength:</span>
                    <span id="passwordStrength" class="text-sm font-medium text-green-500">Strong</span>
                </div>

                <div class="flex flex-wrap gap-x-6 gap-y-2">
                    <div class="flex items-center">
                        <div id="check8Chars" class="w-5 h-5 flex items-center justify-center rounded border border-gray-300 mr-2">
                            <svg class="w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span class="text-sm text-gray-600">8 Characters</span>
                    </div>

                    <div class="flex items-center">
                        <div id="checkNumber" class="w-5 h-5 flex items-center justify-center rounded border border-gray-300 mr-2">
                            <svg class="w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span class="text-sm text-gray-600">1 Number</span>
                    </div>

                    <div class="flex items-center">
                        <div id="checkUppercase" class="w-5 h-5 flex items-center justify-center rounded border border-gray-300 mr-2">
                            <svg class="w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span class="text-sm text-gray-600">Upper case</span>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <button type="submit" id="signUpBtn" class="w-full bg-[#0A4276] text-white py-3 rounded-md font-medium hover:bg-[#154a7d] transition-colors">
                    Sign Up
                </button>

                <p class="text-center text-gray-400 text-xs px-4">
                    By clicking "Sign up", you agree to Onnexsoft's
                    <a href="/terms" class="text-[#69ADD5]">Terms of Use</a> and acknowledge you have read the
                    <a href="/privacy" class="text-[#69ADD5]">Privacy Policy</a>.
                </p>
            </div>
    </form>

    <button type="button" class="w-full flex items-center justify-center bg-[#1E2C39] text-white py-3 rounded-md font-medium hover:bg-[#15213a] transition-colors mb-2">
        <svg class="h-5 w-5 mr-2" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
            <path d="M1 1h22v22H1z" fill="none" />
        </svg>
        Sign up with Google
    </button>

    <div class="text-center text-gray-600 text-sm border-t border-gray-100 py-4">
        Already have an account? <a sp-page="/Accounts/Login" class="text-[#479FC8] cursor-pointer hover:underline">Sign In</a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleBtn = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('Password');

            if (toggleBtn && passwordInput) {
                toggleBtn.addEventListener('click', function() {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);

                    this.innerHTML = type === 'password'
                        ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z" /><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" /></svg>'
                        : '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd" /><path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z" /></svg>';
                });
            }

            const countryCodeBtn = document.getElementById('countryCodeBtn');
            if (countryCodeBtn) {
                countryCodeBtn.addEventListener('click', function() {
                    alert('Country selection would appear here');
                });
            }
        });

        function checkPasswordStrength() {
            const password = document.getElementById('Password').value;
            const strengthContainer = document.getElementById('passwordStrengthContainer');
            const strengthText = document.getElementById('passwordStrength');
            const check8Chars = document.getElementById('check8Chars');
            const checkNumber = document.getElementById('checkNumber');
            const checkUppercase = document.getElementById('checkUppercase');

            if (password.length > 0) {
                strengthContainer.classList.remove('hidden');
            } else {
                strengthContainer.classList.add('hidden');
                return;
            }

            if (password.length >= 8) {
                check8Chars.classList.add('bg-green-500');
                check8Chars.querySelector('svg').classList.remove('hidden');
            } else {
                check8Chars.classList.remove('bg-green-500');
                check8Chars.querySelector('svg').classList.add('hidden');
            }

            if (/\d/.test(password)) {
                checkNumber.classList.add('bg-green-500');
                checkNumber.querySelector('svg').classList.remove('hidden');
            } else {
                checkNumber.classList.remove('bg-green-500');
                checkNumber.querySelector('svg').classList.add('hidden');
            }

            if (/[A-Z]/.test(password)) {
                checkUppercase.classList.add('bg-green-500');
                checkUppercase.querySelector('svg').classList.remove('hidden');
            } else {
                checkUppercase.classList.remove('bg-green-500');
                checkUppercase.querySelector('svg').classList.add('hidden');
            }

            let strength = 0;
            if (password.length >= 8) strength++;
            if (/\d/.test(password)) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[^A-Za-z0-9]/.test(password)) strength++;

            if (strength <= 1) {
                strengthText.textContent = 'Weak';
                strengthText.className = 'text-sm font-medium text-red-500';
            } else if (strength === 2) {
                strengthText.textContent = 'Medium';
                strengthText.className = 'text-sm font-medium text-yellow-500';
            } else {
                strengthText.textContent = 'Strong';
                strengthText.className = 'text-sm font-medium text-green-500';
            }
        }
    </script>
}