@page
@model SsoCore.Provider.Pages.Accounts.ChangePasswordConfirmation

@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Password reset";
}

<section class="flex items-center justify-center min-h-[calc(100vh-80px)] py-8">
    <section class="bg-white rounded-lg shadow-lg w-full max-w-md p-6 sm:p-8 space-y-8">
        <div class="flex justify-center">
            <div class="w-16 h-16 rounded-full bg-blue-50 flex items-center justify-center">
                <img src="~/assets/password_change_success.svg" alt="Password change success" class="h-55 w-58" />
            </div>
        </div>

        <div class="space-y-4">
            <h2 class="text-2xl text-center text-gray-800">Password reset</h2>

            <p class="text-center text-sm text-gray-600">
                Your new password has been reset successfully<br />
                <span>You can use your password to Sign in to your account.</span>
            </p>
        </div>
    
        <a asp-page="Login" class="block w-full bg-[#0A4276] text-white py-3 rounded-md font-medium hover:bg-[#154a7d] transition-colors text-center">
            Sign In
        </a>
    </section>
</section>