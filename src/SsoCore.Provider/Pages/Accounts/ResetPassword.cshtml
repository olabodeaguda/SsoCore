@page
@model SsoCore.Provider.Pages.Accounts.ResetPasswordModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Reset Password"] = "Reset Password";
}

<section class="bg-white rounded-lg shadow-lg w-full max-w-md p-6 sm:p-8">
    <h2 class="text-2xl text-center text-gray-800 mb-6">Reset Password</h2>

    <p class="text-center text-sm text-gray-400 mb-1">Enter the email address you used when you joined</p>
    <p class="text-center text-sm text-gray-400 mb-6">and we’ll send you a link to reset your password.</p>
                
    <form method="post">
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="w-full text-center text-red-700 text-sm">@Model.Error</div>
        }

        @if (!string.IsNullOrEmpty(Model.Success))
        {
            <div class="w-full text-center text-green-700 text-sm">@Model.Success</div>
        }
        
        <div class="mb-4">
            <label for="email" class="block text-sm text-gray-400 mb-2">Email<span class="text-red-500">*</span></label>
            <input id="email" type="email" name="email" value="@Model.Email" class="w-full px-4 py-3 rounded-md bg-gray-100 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#1a5b96] focus:border-transparent" placeholder="Enter you email" />
            <span class="text-red-500 text-sm"></span>
        </div>

        <button type="submit" class="w-full bg-[#0A4276] text-white py-3 rounded-md hover:bg-[#154a7d] transition-colors mb-4">
            Send Reset Link
        </button>

        <div class="text-center">
            <a asp-page="Login" class="text-[#479FC8] text-sm hover:underline">Cancel</a>
        </div>
    </form>
</section>
