@page
@model SsoCore.Provider.Pages.Accounts.ConfirmEmailModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Set Your Password";
    ViewData["WelcomeMessageTitle"] = "Welcome!";
    ViewData["WelcomeMessageText"] = "Set your password to get started.";
    ViewData["DescriptionMessage"] = "Don't miss out on these exciting updates and opportunities. Let's continue making your currency exchange experience smooth and rewarding.";
}

<div class="w-full max-w-[500px] py-8 px-4 flex flex-col justify-center items-center space-y-12">
    <div class="space-y-2">
        <h1 class="text-2xl font-semibold text-gray-900">Set Your Password</h1>
        <p class="text-gray-400 text-sm">Create a new password for your account.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="w-full py-3 text-center text-red-700 text-sm">@Model.Error</div>
    }

    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="w-full py-3 text-center text-green-700 text-sm">@Model.Success</div>
    }

    <form method="post" class="space-y-4">
        <div class="space-y-2">
            <label for="NewPassword" class="block text-sm text-gray-600">New Password</label>
            <div class="relative">
                <input type="password"
                       class="w-full px-4 py-2 outline outline-gray-300 rounded-full focus:ring-blue-300 focus:outline-blue-300"
                       asp-for="NewPassword"
                       placeholder="••••••••" />
            </div>
            <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
        </div>

        <div class="space-y-2">
            <label for="ConfirmPassword" class="block text-sm text-gray-600">Confirm Password</label>
            <div class="relative">
                <input type="password"
                       class="w-full px-4 py-2 outline outline-gray-300 rounded-full focus:ring-blue-300 focus:outline-blue-300"
                       asp-for="ConfirmPassword"
                       placeholder="••••••••" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
        </div>

        <div class="space-y-2">
            <button type="submit"
                    class="w-full cursor-pointer bg-blue-900 text-white py-2 rounded-full hover:bg-blue-800">
                Set Password
            </button>
        </div>
    </form>

    <div class="text-center">
        <a asp-page="/Accounts/Login" class="text-blue-600 hover:text-blue-800">Return to Login</a>
    </div>
</div>