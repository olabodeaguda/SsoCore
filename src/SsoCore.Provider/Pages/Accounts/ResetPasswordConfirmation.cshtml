@page
@model SsoCore.Provider.Pages.Accounts.ResetPasswordConfirmation

@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Check Your Mail";
}

<section class="flex items-center justify-center min-h-[calc(100vh-80px)] py-8">
    <section class="bg-white rounded-lg shadow-lg w-full max-w-md p-6 sm:p-8 space-y-8">
        <div class="flex justify-center">
            <div class="w-16 h-16 rounded-full bg-blue-50 flex items-center justify-center">
                <img src="~/assets/password_reset_success.svg" alt="Password change success" class="h-55 w-58" />
            </div>
        </div>
        
        <div class="space-y-4">
            <h2 class="text-2xl text-center text-gray-800">Check your mail</h2>

            <p class="text-center text-sm text-gray-600">
                A password reset link has been sent to<br />
                <span>@Model.Email</span>
            </p>
        </div>
        
        <form method="post">
            <input type="hidden" asp-for="Email" />
            <button type="submit" class="w-full bg-[#0A4276] text-white py-3 rounded-md font-medium hover:bg-[#154a7d] transition-colors text-center">
                Change Password
            </button>
        </form>
    </section>
</section>